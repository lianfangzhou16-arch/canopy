# --- Web3 QUANT SYSTEM: COMMAND CENTER ---
# Environment Isolation Rule: Mandatory .env usage

# Network Configuration (Neura Protocol Testnet)
RPC_URL=https://testnet.rpc.neuraprotocol.io/
CHAIN_ID=267
SYMBOL=ANKR

# Account Configuration
# WARNING: Never share or hardcode private keys.
PRIVATE_KEY=your_private_key_here

# Operational Parameters
PRIORITY_FEE_GWEI=1.5
SAFETY_MARGIN_ETH=0.01
MAX_CONCURRENT_REQUESTS=5

# Mode: production | development
MODE=development
